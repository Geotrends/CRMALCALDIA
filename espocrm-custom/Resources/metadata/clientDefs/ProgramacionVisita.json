{
    "controller": "controllers/record",
    "iconClass": "fas fa-calendar-alt",
    "color": "#0369a1",
    "recordViews": {
        "detail": "custom:views/programacion-visita/record/detail",
        "edit": "custom:views/programacion-visita/record/edit",
        "editSmall": "custom:views/programacion-visita/record/edit-small",
        "list": "views/record/list"
    },
    "defaultSidePanelDisabled": true,
    "sidePanels": {
        "detail": [
            {
                "name": "fechasRegistro",
                "view": "views/record/panels/side",
                "isForm": true,
                "options": {
                    "fieldList": [
                        {"name": "createdAt"},
                        {"name": "modifiedAt"}
                    ]
                }
            },
            {
                "name": "programacionStream",
                "label": "Historia",
                "view": "views/stream/panel",
                "notRefreshable": true
            }
        ]
    },
    "dynamicLogic": {
        "fields": {
            "tipoProgramacion": {
                "visible": {
                    "conditionGroup": [
                        {"type": "isNotEmpty", "attribute": "id"}
                    ]
                }
            },
            "motivoReprogramacion": {
                "visible": {
                    "conditionGroup": [
                        {"type": "isNotEmpty", "attribute": "id"}
                    ]
                }
            }
        },
        "panels": {
            "reprogramacion": {
                "visible": {
                    "conditionGroup": [
                        {"type": "isNotEmpty", "attribute": "id"}
                    ]
                }
            }
        }
    }
}
