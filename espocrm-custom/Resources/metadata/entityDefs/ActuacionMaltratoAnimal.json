{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "expediente": {
            "type": "link",
            "isCustom": true
        },
        "fechaAtencion": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "estadoAnimalDescripcion": {
            "type": "text",
            "rows": 4,
            "isCustom": true
        },
        "requirioAprehensionPreventiva": {
            "type": "bool",
            "default": false,
            "isCustom": true
        },
        "aprehensionDetalle": {
            "type": "text",
            "rows": 3,
            "isCustom": true
        },
        "aprehensionDocumento": {
            "type": "file",
            "isCustom": true
        },
        "clasificacionJuridica": {
            "type": "enum",
            "options": [
                "Maltrato leve",
                "Posible delito",
                "Concurrencia"
            ],
            "isCustom": true
        },
        "remisionAutoridad": {
            "type": "link",
            "isCustom": true
        },
        "audiencia": {
            "type": "link",
            "isCustom": true
        },
        "ordenPolicia": {
            "type": "link",
            "isCustom": true
        },
        "fundamentoDecision": {
            "type": "text",
            "rows": 4,
            "isCustom": true
        },
        "efectosDecision": {
            "type": "text",
            "rows": 4,
            "isCustom": true
        },
        "documentoDecision": {
            "type": "file",
            "isCustom": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "En atención",
                "Clasificado",
                "En audiencia",
                "Decidido",
                "Pendiente de ejecución",
                "Cerrado"
            ],
            "default": "En atención",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "actuacionesMaltratoAnimal"
        },
        "expediente": {
            "type": "belongsTo",
            "entity": "Expediente",
            "foreign": "actuacionesMaltratoAnimal"
        },
        "remisionAutoridad": {
            "type": "belongsTo",
            "entity": "RemisionAutoridad"
        },
        "audiencia": {
            "type": "belongsTo",
            "entity": "Audiencia"
        },
        "ordenPolicia": {
            "type": "belongsTo",
            "entity": "OrdenPolicia"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\ActuacionMaltratoAnimal",
    "collection": {
        "orderBy": "fechaAtencion",
        "order": "desc",
        "textFilterFields": ["name", "estadoAnimalDescripcion"]
    }
}
