{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "isCustom": true
        },
        "ordenComparendo": {
            "type": "link",
            "isCustom": true
        },
        "fechaInicio": {
            "type": "datetime",
            "required": true,
            "isCustom": true
        },
        "autoridad": {
            "type": "link",
            "required": true,
            "isCustom": true
        },
        "conducta": {
            "type": "text",
            "rows": 4,
            "required": true,
            "isCustom": true
        },
        "descargos": {
            "type": "text",
            "rows": 4,
            "isCustom": true
        },
        "mediacionUtilizada": {
            "type": "bool",
            "default": false,
            "isCustom": true
        },
        "resultado": {
            "type": "enum",
            "required": true,
            "options": [
                "Resuelta por mediación",
                "Con medida correctiva u orden de policía",
                "Sin resolver"
            ],
            "isCustom": true
        },
        "ordenPolicia": {
            "type": "link",
            "isCustom": true
        },
        "medidaCorrectiva": {
            "type": "link",
            "isCustom": true
        },
        "documentoConvivencia": {
            "type": "file",
            "required": true,
            "isCustom": true
        },
        "apelacion": {
            "type": "link",
            "isCustom": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "Iniciada",
                "En mediación",
                "Resuelta por mediación",
                "Con medida impuesta",
                "En apelación",
                "Apelación resuelta",
                "Trasladada a PVA por incumplimiento",
                "Cerrada"
            ],
            "default": "Iniciada",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "actuacionesPoliciaInmediata"
        },
        "ordenComparendo": {
            "type": "belongsTo",
            "entity": "OrdenComparendo",
            "foreign": "actuacionesPoliciaInmediata"
        },
        "autoridad": {
            "type": "belongsTo",
            "entity": "User"
        },
        "ordenPolicia": {
            "type": "belongsTo",
            "entity": "OrdenPolicia",
            "foreign": "actuacionPoliciaInmediata"
        },
        "medidaCorrectiva": {
            "type": "belongsTo",
            "entity": "MedidaCorrectiva",
            "foreign": "actuacionPoliciaInmediata"
        },
        "apelacion": {
            "type": "belongsTo",
            "entity": "Recurso",
            "foreign": "actuacionesPoliciaInmediata"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\ActuacionPoliciaInmediata",
    "collection": {
        "orderBy": "fechaInicio",
        "order": "desc",
        "textFilterFields": ["name", "conducta"]
    }
}
