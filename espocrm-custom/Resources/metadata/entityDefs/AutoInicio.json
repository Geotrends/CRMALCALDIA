{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "expediente": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "fechaAuto": {
            "type": "date",
            "isCustom": true
        },
        "numeroRadicado": {
            "type": "varchar",
            "maxLength": 100,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "consecutivoInterno": {
            "type": "varchar",
            "maxLength": 100,
            "readOnly": true,
            "isCustom": true
        },
        "tipoTramite": {
            "type": "enum",
            "options": [
                "Proceso Verbal Abreviado · Convivencia (Ley 1801/2016)",
                "Recursos Naturales · competencia municipal (Ley 1801/2016)",
                "Conductas de convivencia con animales (Ley 1801/2016)",
                "Proceso Verbal de Maltrato Animal (Ley 84/1989 - Ley 2455/2025)",
                "Sin definir",
                "Sancionatorio ambiental (Ley 1333/2009 - IV-P-028)",
                "Código de policía y bienestar animal (Ley 1801/2016 - IV-P-021)"
            ],
            "default": "Sin definir",
            "isCustom": true
        },
        "referencia": {
            "type": "text",
            "rows": 3,
            "isCustom": true
        },
        "motivoApertura": {
            "type": "text",
            "rows": 8,
            "isCustom": true
        },
        "fechaDada": {
            "type": "date",
            "isCustom": true
        },
        "inspector": {
            "type": "link",
            "isCustom": true
        },
        "inspectorCargo": {
            "type": "varchar",
            "maxLength": 200,
            "default": "Profesional Universitario - Área Jurídica",
            "isCustom": true
        },
        "estado": {
            "type": "enum",
            "options": ["Pendiente", "Para firma", "Devuelto", "Firmado", "Diligenciada"],
            "default": "Pendiente",
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "cFormatoAutoInicioPdf": {
            "type": "file",
            "readOnly": true,
            "isCustom": true
        },
        "normasSeleccionadas": {
            "type": "array",
            "view": "custom:views/auto-inicio/fields/normas",
            "isCustom": true,
            "audited": true
        },
        "normaAplicable": {
            "type": "text",
            "isCustom": true,
            "audited": true
        },
        "fechaAudiencia": {
            "type": "date",
            "isCustom": true,
            "audited": true
        },
        "horaAudiencia": {
            "type": "varchar",
            "view": "custom:views/fields/hora-reloj",
            "maxLength": 20,
            "isCustom": true,
            "audited": true
        },
        "cFormatoAutoInicioDocx": {
            "type": "file",
            "readOnly": true,
            "isCustom": true
        },
        "actoFirmado": {
            "type": "file",
            "isCustom": true,
            "audited": true
        },
        "fechaFirma": {
            "type": "datetime",
            "readOnly": true,
            "isCustom": true,
            "audited": true
        },
        "observacionesDevolucion": {
            "type": "text",
            "readOnly": true,
            "isCustom": true,
            "audited": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "autosInicio"
        },
        "expediente": {
            "type": "belongsTo",
            "entity": "Expediente",
            "foreign": "autosInicio"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "inspector": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\AutoInicio",
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": ["name", "numeroRadicado", "consecutivoInterno", "referencia"]
    }
}
