{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "expediente": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "intervencionOrigen": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "texto": {
            "type": "text",
            "rows": 5,
            "required": true,
            "isCustom": true
        },
        "partes": {
            "type": "text",
            "rows": 3,
            "required": true,
            "isCustom": true
        },
        "fecha": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "fechaLimite": {
            "type": "date",
            "isCustom": true
        },
        "criterioCumplimiento": {
            "type": "text",
            "rows": 3,
            "isCustom": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "Pendiente",
                "En plazo",
                "Vencida",
                "En verificación",
                "Cumplida",
                "Parcial",
                "No cumplida",
                "No verificable",
                "Cerrada"
            ],
            "default": "Pendiente",
            "isCustom": true
        },
        "documentoOrigen": {
            "type": "file",
            "required": true,
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "compromisos"
        },
        "expediente": {
            "type": "belongsTo",
            "entity": "Expediente",
            "foreign": "compromisos"
        },
        "intervencionOrigen": {
            "type": "belongsTo",
            "entity": "IntervencionTecnica",
            "foreign": "compromisos"
        },
        "verificacionesCumplimiento": {
            "type": "hasMany",
            "entity": "VerificacionCumplimiento",
            "foreign": "compromiso"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\Compromiso",
    "collection": {
        "orderBy": "fecha",
        "order": "desc",
        "textFilterFields": ["name", "texto", "partes"]
    }
}
