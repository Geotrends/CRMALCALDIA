{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "evaluacionResultado": {
            "type": "link",
            "isCustom": true
        },
        "decisor": {
            "type": "link",
            "required": true,
            "isCustom": true
        },
        "fechaDecision": {
            "type": "datetime",
            "isCustom": true
        },
        "resultado": {
            "type": "enum",
            "options": [
                "Sin mérito",
                "Nueva gestión técnica",
                "Remisión a otra autoridad",
                "Ruta policiva",
                "Ruta Recursos Naturales - Competencia Municipal",
                "Ruta Tenencia Animal",
                "Ruta Maltrato Animal",
                "Ruta Ambiental Preventiva / Remisión"
            ],
            "required": true,
            "isCustom": true
        },
        "fundamentoNormativo": {
            "type": "text",
            "rows": 3,
            "isCustom": true
        },
        "motivacion": {
            "type": "text",
            "rows": 6,
            "required": true,
            "isCustom": true
        },
        "expediente": {
            "type": "link",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "decisionesRuta"
        },
        "evaluacionResultado": {
            "type": "belongsTo",
            "entity": "EvaluacionResultado",
            "foreign": "decisionesRuta"
        },
        "decisor": {
            "type": "belongsTo",
            "entity": "User"
        },
        "expediente": {
            "type": "belongsTo",
            "entity": "Expediente",
            "foreign": "decisionesRuta"
        },
        "actuacionesRNMC": {
            "type": "hasMany",
            "entity": "ActuacionRNMC",
            "foreign": "decisionRuta"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\DecisionRutaJuridica",
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": ["name", "motivacion"]
    }
}
