{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "fecha": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "resultadoTecnico": {
            "type": "text",
            "rows": 4,
            "isCustom": true
        },
        "informacionSuficiente": {
            "type": "bool",
            "default": false,
            "isCustom": true
        },
        "situacionResuelta": {
            "type": "bool",
            "default": false,
            "isCustom": true
        },
        "recomiendaNuevaGestion": {
            "type": "bool",
            "default": false,
            "isCustom": true
        },
        "recomiendaEscalamiento": {
            "type": "bool",
            "default": false,
            "isCustom": true
        },
        "responsableTecnico": {
            "type": "link",
            "isCustom": true
        },
        "observaciones": {
            "type": "text",
            "rows": 3,
            "isCustom": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "En preparación",
                "Pendiente de soportes",
                "Completa",
                "Derivada a nueva gestión",
                "Derivada a remisión",
                "Derivada a valoración jurídica",
                "Cerrada"
            ],
            "default": "En preparación",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "evaluacionesResultado"
        },
        "responsableTecnico": {
            "type": "belongsTo",
            "entity": "User"
        },
        "decisionesRuta": {
            "type": "hasMany",
            "entity": "DecisionRutaJuridica",
            "foreign": "evaluacionResultado"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\EvaluacionResultado",
    "collection": {
        "orderBy": "fecha",
        "order": "desc",
        "textFilterFields": ["name", "resultadoTecnico"]
    }
}
