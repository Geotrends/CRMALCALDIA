{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 100,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "numero": {
            "type": "varchar",
            "maxLength": 100,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "anio": {
            "type": "varchar",
            "maxLength": 4,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "consecutivo": {
            "type": "int",
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "tipoTramite": {
            "type": "enum",
            "options": [
                "Proceso Verbal Abreviado · Convivencia (Ley 1801/2016)",
                "Recursos Naturales · competencia municipal (Ley 1801/2016)",
                "Conductas de convivencia con animales (Ley 1801/2016)",
                "Proceso Verbal de Maltrato Animal (Ley 84/1989 - Ley 2455/2025)",
                "Sin definir",
                "Sancionatorio ambiental (Ley 1333/2009 - IV-P-028)",
                "Código de policía y bienestar animal (Ley 1801/2016 - IV-P-021)"
            ],
            "default": "Sin definir",
            "isCustom": true
        },
        "fechaInicioPaso": {
            "type": "date",
            "readOnly": true,
            "isCustom": true
        },
        "fechaAperturaFormal": {
            "type": "datetime",
            "readOnly": true,
            "isCustom": true,
            "audited": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "Preparación",
                "Abierto",
                "Citación",
                "Decisión: orden de policía o medida correctiva",
                "Notificación y recursos",
                "Cumplimiento de la orden o medida",
                "Consolidación técnica y antecedentes",
                "Valoración de competencia municipal y concurrencia ambiental",
                "Clasificación de la conducta (artículo y numeral)",
                "Atención y verificación de urgencia",
                "Aprehensión material preventiva (si aplica)",
                "Clasificación jurídica: maltrato leve o posible delito",
                "Remisión a Fiscalía / GELMA (si aplica)",
                "Audiencia de maltrato animal",
                "Decisión de fondo",
                "Cumplimiento y seguimiento",
                "Elaboración de acto de decisión",
                "Notificación de acto administrativo",
                "Remisión a Autoridad Ambiental",
                "Audiencia pública",
                "Práctica de pruebas",
                "Recepción y respuesta de recursos",
                "Revisión de pago de sanciones pecuniarias",
                "Verificación de acción correctiva",
                "Auto de Archivo"
            ],
            "default": "Abierto",
            "isCustom": true,
            "readOnly": true
        },
        "decisionFondo": {
            "type": "jsonObject",
            "isCustom": true
        },
        "decisionBorrador": {
            "type": "file",
            "readOnly": true,
            "isCustom": true
        },
        "decisionFirmada": {
            "type": "file",
            "isCustom": true
        },
        "autoArchivoFormato": {
            "type": "file",
            "readOnly": true,
            "isCustom": true
        },
        "autoArchivoFirmado": {
            "type": "file",
            "isCustom": true
        },
        "historialPasos": {
            "type": "jsonObject",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "casos": {
            "type": "hasMany",
            "entity": "Case",
            "foreign": "expediente"
        },
        "obligacionesPecuniarias": {
            "type": "hasMany",
            "entity": "ObligacionPecuniaria",
            "foreign": "expediente"
        },
        "autosInicio": {
            "type": "hasMany",
            "entity": "AutoInicio",
            "foreign": "expediente"
        },
        "decisionesRuta": {
            "type": "hasMany",
            "entity": "DecisionRutaJuridica",
            "foreign": "expediente"
        },
        "remisionesAutoridad": {
            "type": "hasMany",
            "entity": "RemisionAutoridad",
            "foreign": "expediente"
        },
        "audiencias": {
            "type": "hasMany",
            "entity": "Audiencia",
            "foreign": "expediente"
        },
        "ordenesPolicia": {
            "type": "hasMany",
            "entity": "OrdenPolicia",
            "foreign": "expediente"
        },
        "medidasCorrectivas": {
            "type": "hasMany",
            "entity": "MedidaCorrectiva",
            "foreign": "expediente"
        },
        "notificacionesActo": {
            "type": "hasMany",
            "entity": "NotificacionActo",
            "foreign": "expediente"
        },
        "recursos": {
            "type": "hasMany",
            "entity": "Recurso",
            "foreign": "expediente"
        },
        "movimientosExpediente": {
            "type": "hasMany",
            "entity": "MovimientoExpediente",
            "foreign": "expediente"
        },
        "actuacionesMaltratoAnimal": {
            "type": "hasMany",
            "entity": "ActuacionMaltratoAnimal",
            "foreign": "expediente"
        },
        "compromisos": {
            "type": "hasMany",
            "entity": "Compromiso",
            "foreign": "expediente"
        },
        "actuacionesRNMC": {
            "type": "hasMany",
            "entity": "ActuacionRNMC",
            "foreign": "expediente"
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\Expediente",
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": [
            "name",
            "numero"
        ]
    }
}
