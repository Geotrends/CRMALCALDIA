{
    "fields": {
        "name": {
            "audited": true,
            "type": "varchar",
            "required": true,
            "maxLength": 200,
            "trim": true
        },
        "gestionTecnica": {
            "audited": true,
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "tipo": {
            "audited": true,
            "type": "enum",
            "options": [
                "Visita",
                "Medición",
                "Revisión",
                "Consulta",
                "Informe",
                "Recomendación",
                "Compromiso",
                "Verificación"
            ],
            "required": true,
            "isCustom": true
        },
        "fechaSolicitud": {
            "audited": true,
            "type": "datetime",
            "isCustom": true
        },
        "fechaProgramada": {
            "audited": true,
            "type": "date",
            "isCustom": true
        },
        "fechaEjecucion": {
            "audited": true,
            "type": "date",
            "isCustom": true
        },
        "responsable": {
            "audited": true,
            "type": "link",
            "isCustom": true
        },
        "estado": {
            "audited": true,
            "type": "enum",
            "options": [
                "Pendiente",
                "Programada",
                "En ejecución",
                "Pendiente de soporte",
                "Completa documentalmente",
                "No realizada",
                "Reprogramada",
                "Cancelada"
            ],
            "default": "Pendiente",
            "isCustom": true
        },
        "resultado": {
            "audited": true,
            "type": "text",
            "rows": 4,
            "isCustom": true
        },
        "survey123FormId": {
            "type": "varchar",
            "maxLength": 100,
            "isCustom": true
        },
        "survey123SubmissionId": {
            "type": "varchar",
            "maxLength": 100,
            "isCustom": true
        },
        "survey123Url": {
            "type": "varchar",
            "maxLength": 500,
            "isCustom": true
        },
        "survey123FechaCaptura": {
            "type": "datetime",
            "isCustom": true
        },
        "survey123Ubicacion": {
            "type": "varchar",
            "maxLength": 255,
            "isCustom": true
        },
        "informeTecnicoDocumento": {
            "type": "file",
            "isCustom": true
        },
        "anexos": {
            "type": "attachmentMultiple",
            "sourceList": ["Document"],
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "gestionTecnica": {
            "type": "belongsTo",
            "entity": "GestionTecnica",
            "foreign": "intervencionesTecnicas"
        },
        "responsable": {
            "type": "belongsTo",
            "entity": "User"
        },
        "programacionesVisita": {
            "type": "hasMany",
            "audited": true,
            "entity": "ProgramacionVisita",
            "foreign": "intervencionTecnica"
        },
        "recomendacionesTecnicas": {
            "type": "hasMany",
            "entity": "RecomendacionTecnica",
            "foreign": "intervencionOrigen"
        },
        "compromisos": {
            "type": "hasMany",
            "entity": "Compromiso",
            "foreign": "intervencionOrigen"
        },
        "verificacionesCumplimiento": {
            "type": "hasMany",
            "entity": "VerificacionCumplimiento",
            "foreign": "intervencionTecnica"
        },
        "actasVisita": {
            "type": "hasMany",
            "entity": "ActaVisita",
            "foreign": "intervencionTecnica"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\IntervencionTecnica",
    "collection": {
        "orderBy": "fechaSolicitud",
        "order": "desc",
        "textFilterFields": ["name", "resultado"]
    }
}
