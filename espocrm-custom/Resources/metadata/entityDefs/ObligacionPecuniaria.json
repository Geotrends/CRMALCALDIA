{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "isCustom": true
        },
        "expediente": {
            "type": "link",
            "isCustom": true
        },
        "medidaCorrectiva": {
            "type": "link",
            "isCustom": true
        },
        "ejecucionMedidaCorrectiva": {
            "type": "link",
            "isCustom": true
        },
        "sujetoObligado": {
            "type": "varchar",
            "maxLength": 255,
            "required": true,
            "isCustom": true
        },
        "concepto": {
            "type": "text",
            "rows": 3,
            "required": true,
            "isCustom": true
        },
        "valor": {
            "type": "float",
            "required": true,
            "isCustom": true
        },
        "fechaEjecutoria": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "fechaExigibilidad": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "documentoSoporteEjecutoria": {
            "type": "file",
            "isCustom": true
        },
        "remisionTesoreria": {
            "type": "link",
            "isCustom": true
        },
        "referenciaExternaRecaudo": {
            "type": "varchar",
            "maxLength": 255,
            "isCustom": true
        },
        "fechaAlertaControl": {
            "type": "date",
            "isCustom": true
        },
        "estadoRecaudo": {
            "type": "enum",
            "options": [
                "Remitida",
                "Registrada en Tesorería",
                "Pendiente de pago",
                "En seguimiento",
                "Pagada",
                "En acuerdo de pago",
                "En cobro coactivo",
                "Cerrada"
            ],
            "default": "Remitida",
            "isCustom": true
        },
        "observaciones": {
            "type": "text",
            "rows": 3,
            "isCustom": true
        },
        "fechaActualizacionExpediente": {
            "type": "date",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "obligacionesPecuniarias"
        },
        "expediente": {
            "type": "belongsTo",
            "entity": "Expediente",
            "foreign": "obligacionesPecuniarias"
        },
        "medidaCorrectiva": {
            "type": "belongsTo",
            "entity": "MedidaCorrectiva",
            "foreign": "obligacionesPecuniarias"
        },
        "ejecucionMedidaCorrectiva": {
            "type": "belongsTo",
            "entity": "EjecucionMedidaCorrectiva",
            "foreign": "obligacionPecuniaria"
        },
        "remisionTesoreria": {
            "type": "belongsTo",
            "entity": "RemisionAutoridad",
            "foreign": "obligacionesPecuniarias"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\ObligacionPecuniaria",
    "collection": {
        "orderBy": "fechaExigibilidad",
        "order": "desc",
        "textFilterFields": ["name", "sujetoObligado", "concepto"]
    }
}
