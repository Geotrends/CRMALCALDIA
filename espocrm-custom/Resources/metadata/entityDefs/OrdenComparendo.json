{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "isCustom": true
        },
        "numeroComparendo": {
            "type": "varchar",
            "maxLength": 100,
            "isCustom": true
        },
        "fecha": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "autoridadEmisora": {
            "type": "link",
            "required": true,
            "isCustom": true
        },
        "comportamientoCodigo": {
            "type": "varchar",
            "maxLength": 100,
            "isCustom": true
        },
        "documento": {
            "type": "file",
            "isCustom": true
        },
        "referenciaRNMC": {
            "type": "varchar",
            "maxLength": 150,
            "isCustom": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "Registrado",
                "Vinculado a actuación",
                "Anulado"
            ],
            "default": "Registrado",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "ordenesComparendo"
        },
        "autoridadEmisora": {
            "type": "belongsTo",
            "entity": "User"
        },
        "actuacionesPoliciaInmediata": {
            "type": "hasMany",
            "entity": "ActuacionPoliciaInmediata",
            "foreign": "ordenComparendo"
        },
        "actuacionesRNMC": {
            "type": "hasMany",
            "entity": "ActuacionRNMC",
            "foreign": "ordenComparendo"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\OrdenComparendo",
    "collection": {
        "orderBy": "fecha",
        "order": "desc",
        "textFilterFields": ["name", "numeroComparendo"]
    }
}
