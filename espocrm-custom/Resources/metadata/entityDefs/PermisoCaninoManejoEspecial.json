{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "registroCaninoManejoEspecial": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "numeroPermiso": {
            "type": "varchar",
            "maxLength": 100,
            "isCustom": true
        },
        "fechaExpedicion": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "fechaVencimiento": {
            "type": "date",
            "isCustom": true
        },
        "autoridadEmisora": {
            "type": "link",
            "isCustom": true
        },
        "documento": {
            "type": "file",
            "required": true,
            "isCustom": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "Vigente",
                "Vencido",
                "Revocado"
            ],
            "default": "Vigente",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "registroCaninoManejoEspecial": {
            "type": "belongsTo",
            "entity": "RegistroCaninoManejoEspecial",
            "foreign": "permisos"
        },
        "autoridadEmisora": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\PermisoCaninoManejoEspecial",
    "collection": {
        "orderBy": "fechaExpedicion",
        "order": "desc",
        "textFilterFields": ["name", "numeroPermiso"]
    }
}
