{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "intervencionOrigen": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true,
            "isCustom": true,
            "audited": true
        },
        "texto": {
            "type": "text",
            "rows": 5,
            "required": true,
            "isCustom": true,
            "audited": true
        },
        "fundamentoTecnico": {
            "type": "text",
            "rows": 4,
            "isCustom": true,
            "audited": true
        },
        "destinatario": {
            "type": "varchar",
            "maxLength": 255,
            "isCustom": true,
            "audited": true
        },
        "fechaInicio": {
            "type": "date",
            "required": true,
            "isCustom": true,
            "audited": true
        },
        "fechaLimite": {
            "type": "date",
            "isCustom": true,
            "audited": true
        },
        "criterioVerificacion": {
            "type": "text",
            "rows": 3,
            "isCustom": true,
            "audited": true
        },
        "requiereVerificacion": {
            "type": "bool",
            "default": false,
            "isCustom": true,
            "audited": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "Pendiente",
                "En plazo",
                "Vencida",
                "En verificación",
                "Cumplida",
                "Parcial",
                "No cumplida",
                "No verificable",
                "Cerrada"
            ],
            "default": "Pendiente",
            "isCustom": true,
            "audited": true
        },
        "documentoOrigen": {
            "type": "file",
            "required": true,
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "intervencionOrigen": {
            "type": "belongsTo",
            "entity": "IntervencionTecnica",
            "foreign": "recomendacionesTecnicas"
        },
        "verificacionesCumplimiento": {
            "type": "hasMany",
            "entity": "VerificacionCumplimiento",
            "foreign": "recomendacionTecnica"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\RecomendacionTecnica",
    "collection": {
        "orderBy": "fechaInicio",
        "order": "desc",
        "textFilterFields": ["name", "texto"]
    }
}
