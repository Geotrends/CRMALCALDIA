{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "identificacionAnimal": {
            "type": "varchar",
            "maxLength": 200,
            "required": true,
            "isCustom": true
        },
        "descripcionFenotipica": {
            "type": "text",
            "rows": 3,
            "isCustom": true
        },
        "propietario": {
            "type": "varchar",
            "maxLength": 200,
            "required": true,
            "isCustom": true
        },
        "residenciaHabitual": {
            "type": "varchar",
            "maxLength": 200,
            "isCustom": true
        },
        "destinacion": {
            "type": "varchar",
            "maxLength": 200,
            "isCustom": true
        },
        "polizaDocumento": {
            "type": "file",
            "isCustom": true
        },
        "vacunacionDocumento": {
            "type": "file",
            "isCustom": true
        },
        "certificadoSanidadDocumento": {
            "type": "file",
            "isCustom": true
        },
        "fechaRegistro": {
            "type": "date",
            "isCustom": true
        },
        "fechaRenovacion": {
            "type": "date",
            "isCustom": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "Solicitado",
                "Pendiente de subsanación",
                "En validación",
                "Registrado",
                "Rechazado"
            ],
            "default": "Solicitado",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "registrosCaninoManejoEspecial"
        },
        "permisos": {
            "type": "hasMany",
            "entity": "PermisoCaninoManejoEspecial",
            "foreign": "registroCaninoManejoEspecial"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\RegistroCaninoManejoEspecial",
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": ["name", "identificacionAnimal", "propietario"]
    }
}
