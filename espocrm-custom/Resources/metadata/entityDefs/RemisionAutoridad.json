{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "case": {
            "type": "link",
            "required": true,
            "readOnlyAfterCreate": true,
            "isCustom": true
        },
        "expediente": {
            "type": "link",
            "isCustom": true
        },
        "autoridadDestino": {
            "type": "varchar",
            "maxLength": 200,
            "required": true,
            "isCustom": true
        },
        "fechaRemision": {
            "type": "date",
            "isCustom": true
        },
        "oficioDocumento": {
            "type": "file",
            "isCustom": true
        },
        "anexos": {
            "type": "attachmentMultiple",
            "isCustom": true
        },
        "fechaRecibido": {
            "type": "date",
            "isCustom": true
        },
        "numeroExpedienteExterno": {
            "type": "varchar",
            "maxLength": 100,
            "isCustom": true
        },
        "estadoSeguimiento": {
            "type": "enum",
            "options": [
                "Preparación",
                "Enviada",
                "Recibida",
                "En seguimiento",
                "Con expediente externo",
                "Respuesta recibida",
                "Cerrada"
            ],
            "default": "Preparación",
            "isCustom": true
        },
        "observaciones": {
            "type": "text",
            "rows": 4,
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "case": {
            "type": "belongsTo",
            "entity": "Case",
            "foreign": "remisionesAutoridad"
        },
        "expediente": {
            "type": "belongsTo",
            "entity": "Expediente",
            "foreign": "remisionesAutoridad"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\RemisionAutoridad",
    "collection": {
        "orderBy": "createdAt",
        "order": "desc",
        "textFilterFields": ["name", "autoridadDestino", "numeroExpedienteExterno"]
    }
}
