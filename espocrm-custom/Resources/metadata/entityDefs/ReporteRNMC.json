{
    "fields": {
        "name": {
            "type": "varchar",
            "required": false,
            "maxLength": 200,
            "trim": true,
            "readOnlyAfterCreate": true
        },
        "medidaCorrectiva": {
            "type": "link",
            "isCustom": true
        },
        "ordenComparendo": {
            "type": "link",
            "isCustom": true
        },
        "fechaReporte": {
            "type": "date",
            "required": true,
            "isCustom": true
        },
        "medio": {
            "type": "varchar",
            "maxLength": 150,
            "required": true,
            "isCustom": true
        },
        "responsable": {
            "type": "link",
            "required": true,
            "isCustom": true
        },
        "identificadorExterno": {
            "type": "varchar",
            "maxLength": 150,
            "isCustom": true
        },
        "documentoConstancia": {
            "type": "file",
            "isCustom": true
        },
        "estado": {
            "type": "enum",
            "options": [
                "Pendiente",
                "Reportado",
                "Constancia cargada",
                "Error de reporte",
                "Por validar integración"
            ],
            "default": "Pendiente",
            "isCustom": true
        },
        "assignedUser": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "view": "views/fields/assigned-user"
        },
        "teams": {
            "type": "linkMultiple",
            "view": "views/fields/teams"
        },
        "createdAt": {
            "type": "datetime",
            "readOnly": true
        },
        "modifiedAt": {
            "type": "datetime",
            "readOnly": true
        }
    },
    "links": {
        "medidaCorrectiva": {
            "type": "belongsTo",
            "entity": "MedidaCorrectiva",
            "foreign": "reportesRNMC"
        },
        "ordenComparendo": {
            "type": "belongsTo",
            "entity": "OrdenComparendo",
            "foreign": "reportesRNMC"
        },
        "responsable": {
            "type": "belongsTo",
            "entity": "User"
        },
        "assignedUser": {
            "type": "belongsTo",
            "entity": "User"
        },
        "teams": {
            "type": "hasMany",
            "entity": "Team",
            "relationName": "entityTeam",
            "layoutRelationshipsDisabled": true
        },
        "createdBy": {
            "type": "belongsTo",
            "entity": "User"
        },
        "modifiedBy": {
            "type": "belongsTo",
            "entity": "User"
        }
    },
    "entityClassName": "Espo\\Custom\\Entities\\ReporteRNMC",
    "collection": {
        "orderBy": "fechaReporte",
        "order": "desc",
        "textFilterFields": ["name", "identificadorExterno"]
    }
}
