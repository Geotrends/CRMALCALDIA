        "recomendacionTecnica": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "isCustom": true,
            "audited": true
        },
        "compromiso": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "isCustom": true,
            "audited": true
        },
        "medidaCorrectiva": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "isCustom": true,
            "audited": true
        },
        "ordenPolicia": {
            "type": "link",
            "readOnlyAfterCreate": true,
            "isCustom": true,
            "audited": true
        },
