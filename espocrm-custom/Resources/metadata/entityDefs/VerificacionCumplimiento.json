            "foreign": "verificacionesCumplimiento"
        },
        "compromiso": {
            "type": "belongsTo",
            "entity": "Compromiso",
            "foreign": "verificacionesCumplimiento"
        },
        "medidaCorrectiva": {
            "type": "belongsTo",
            "entity": "MedidaCorrectiva",
            "foreign": "verificacionesCumplimiento"
        },
        "ordenPolicia": {
            "type": "belongsTo",
            "entity": "OrdenPolicia",
            "foreign": "verificacionesCumplimiento"
        },
        "intervencionTecnica": {
